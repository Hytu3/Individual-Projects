@{
    ViewBag.Title = "Home Page";
}

<main>
    <section class="row" aria-labelledby="PetBoardingTitle">
        <h1 id="title">Welcome to PetBoarding!</h1>
        <p class="lead">Below you can select to either register a new pet or add a new booking.</p>
    </section>

    <div class="row">
        <section class="col-md-4" aria-labelledby="addPetTitle">
            <h2 id="addPetTitle">Add a new pet</h2>
            <p>
                Click the button below to add a new pet!
            </p>
            <a class="btn btn-outline-dark" href="@Url.Action("Index", "Pets")">Add pet &raquo;</a>
            </p>
        </section>
        <section class="col-md-4" aria-labelledby="scheduleBookingTitle">
            <h2 id="scheduleBookingTitle">Schedule a new booking</h2>
            <p>Click the button below to schedule a new booking!</p>
            <a class="btn btn-outline-dark" href="@Url.Action("Index", "Bookings")">Schedule booking &raquo;</a>
        </section>
    </div>
</main>