@model PetBoardingApp.ViewModels.ContactUsViewModel

@{
    ViewBag.Title = "Contact Us";
}

<h2>Contact Us</h2>

@using (Html.BeginForm("Create", "ContactUs", FormMethod.Post))
{
    <div class="mb-3">
        <label class="form-label">Email</label>
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", required = "required" })
    </div>

    <div class="mb-3">
        <label class="form-label">Phone Number</label>
        @Html.TextBoxFor(m => m.Phone_number, new { @class = "form-control", required = "required" })
    </div>

    <div class="mb-3">
        <label class="form-label">Address</label>
        @Html.TextBoxFor(m => m.Address, new { @class = "form-control" })
    </div>

    <div class="mb-3">
        <label class="form-label">Message</label>
        @Html.TextAreaFor(m => m.Message, new { @class = "form-control", rows = "4" })
    </div>

    <button type="submit" class="btn btn-primary">Create Contact Entry</button>
}

<br />
<h3>Delete Contact Entry</h3>

@using (Html.BeginForm("Delete", "ContactUs", FormMethod.Post))
{
    <button type="submit" class="btn btn-primary">Delete Contact Entry</button>
}